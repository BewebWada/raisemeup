<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Internal Markdown documents must not be served over HTTP.
<FilesMatch "(?i)\.md$">
    Require all denied
</FilesMatch>

# Git metadata must never be served from the document root.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(?:/|$) - [F,L,NC]
</IfModule>
