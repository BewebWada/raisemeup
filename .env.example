# 共通
DB_HOST=localhost
APP_BASE_URL=https://tayori-net.jp

# raisemeup サービス用(RAISEMEUP_ プレフィックス)
RAISEMEUP_DB_NAME=raisemeup
RAISEMEUP_DB_USER=
RAISEMEUP_DB_PASS=

# Stripe(サンドボックス/本番とも sk_test_.../sk_live_... をそのまま設定)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LINE公式アカウントの友だち追加URL(LINE Official Account Managerの「友だちを増やす」から取得)
# LINEログインの設定が済むまでの間や、失敗時のフォールバックとして使う(QRコード+連携コード手入力)
LINE_ADD_FRIEND_URL=

# ご家族向け通知専用のLINE公式アカウント(利用者用とは別チャネル)
LINE_FAMILY_CHANNEL_SECRET=
LINE_FAMILY_CHANNEL_ACCESS_TOKEN=
LINE_FAMILY_ADD_FRIEND_URL=

# LINEログイン(コード入力なしでのLINE連携用)。利用者用・家族用それぞれの公式アカウントに対応する
# 「LINEログインチャネル」をLINE Developersで新規作成し、Messaging APIチャネルと同一プロバイダー内で
# 「Linked OA」設定を行った上で発行される値。未設定の間は連携コード方式(QR+手入力)にフォールバックする。
# コールバックURLとして https://tayori-net.jp/line_login_callback.php を登録すること
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# コールバックURLとして https://tayori-net.jp/family_line_login_callback.php を登録すること
LINE_FAMILY_LOGIN_CHANNEL_ID=
LINE_FAMILY_LOGIN_CHANNEL_SECRET=

# メール送信(リマインド通知用)。Google WorkspaceのSMTP(2段階認証を有効にしたアカウントの
# アプリパスワードを使用)を想定。未設定の間はメール送信自体がスキップされる。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=support@tayori-net.jp
SMTP_PASSWORD=
SMTP_FROM_NAME=Raise Me Up
